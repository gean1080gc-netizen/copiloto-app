<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COPILOTO AUTO"
            android:textColor="#00FF66"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo Direção"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- Botão Principal Liga/Desliga -->
        <LinearLayout
            android:id="@+id/btnToggleState"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="20dp"
            android:background="#00FF66"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSISTENTE ATIVO"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toque para pausar a leitura"
                android:textColor="#121212"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Botão de Silêncio Rápido -->
        <LinearLayout
            android:id="@+id/btnMute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#220000"
            android:padding="14dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤫 SILENCIAR ÁUDIO AGORA"
                android:textColor="#FF4444"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Seleção de Aplicativos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APLICATIVOS MONITORADOS"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <CheckBox
                android:id="@+id/chkUber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Uber"
                android:textColor="#FFFFFF"
                android:checked="true"
                android:buttonTint="#00FF66" />

            <CheckBox
                android:id="@+id/chk99"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="99"
                android:textColor="#FFFFFF"
                android:checked="true"
                android:buttonTint="#00FF66" />

            <CheckBox
                android:id="@+id/chkWhats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:textColor="#FFFFFF"
                android:checked="false"
                android:buttonTint="#00FF66" />
        </LinearLayout>

        <!-- Ferramentas e Configurações -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIGURAÇÕES RÁPIDAS"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <!-- Card Permissões -->
        <LinearLayout
            android:id="@+id/cardPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111111"
            android:padding="16dp"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Permissão de Notificações"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acessar painel do Android para permitir leitura."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Card Testar Áudio -->
        <LinearLayout
            android:id="@+id/btnTestAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#111111"
            android:padding="16dp"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ Simular Leitura em Voz Alta"
                android:textColor="#00FF66"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Testar áudio de aviso de nova corrida."
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
